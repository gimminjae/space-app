SITE_URL=https://space.service.io.kr
SITE_AUTHOR=space 에디터
# Server-only Supabase credentials. Never prefix these with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Legacy alternative: SUPABASE_SERVICE_ROLE_KEY=
# Supabase Auth email/password replaces the old shared admin password.
# Turn on after SMTP and authentication redirects are configured.
AUTH_EMAIL_READY=false
AWS_REGION=ap-northeast-2
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Temporary AWS credentials only:
AWS_SESSION_TOKEN=
# Optional S3-compatible development endpoint:
S3_ENDPOINT=
# Publisher confirmed in the user's AdSense account. Ads remain off until enabled.
ADSENSE_CLIENT_ID=ca-pub-4493633870090510
ADSENSE_ENABLED=false
# Optional if URL-prefix verification is needed; domain property already exists.
GOOGLE_SITE_VERIFICATION=
NAVER_SITE_VERIFICATION=
CONTACT_EMAIL=

# Server-only economic data. Enable only after schema, seed and source review.
FRED_API_KEY=
ECOS_API_KEY=
ECONOMIC_SYNC_ENABLED=false
